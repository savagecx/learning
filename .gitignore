# Generated by Cargo
# will have compiled files and executables
rustfinity/**/debug
rustfinity/**/target

rustplatform/**/debug
rustplatform/**/target

# These are backup files generated by rustfmt
**/*.rs.bk

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustfinity/**/rustc-ice-*.txt
rustplatform/**/rustc-ice-*.txt

# Python Cache
__pycache__/

# Not tracked
codecrafters/
codewars/
python/
rust/
